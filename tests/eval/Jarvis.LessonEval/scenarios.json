      "signals": [ { "kind": "regenerate", "message": "m1", "hoursAgo": 22 }, { "kind": "regenerate", "message": "m2", "hoursAgo": 22 } ],
      "expect": [ { "tool": "CreateReminder", "incidents": 2, "reasons": [ "regenerated" ] } ] },
    { "id": "a-correction-belongs-to-the-reply-before-it",
