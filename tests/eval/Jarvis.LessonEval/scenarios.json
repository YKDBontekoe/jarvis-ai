                  { "id": "t2", "conversation": "c2", "message": "m2", "hoursAgo": 25, "tools": [ { "tool": "SearchMail", "outcome": "completed" } ] },
                  { "id": "t3", "conversation": "c3", "message": "m3", "hoursAgo": 26, "tools": [ { "tool": "SearchMail", "outcome": "completed" } ] } ],
      "expect": [] },
    { "id": "two-thumbs-down-blame-the-tools-used",
