{
  "mining": [
    { "id": "tool-fails-twice",
      "traces": [ { "id": "t1", "conversation": "c1", "message": "m1", "hoursAgo": 24, "tools": [ { "tool": "SearchMail", "outcome": "failed" } ] },
                  { "id": "t2", "conversation": "c2", "message": "m2", "hoursAgo": 30, "tools": [ { "tool": "SearchMail", "outcome": "failed" } ] } ],
      "signals": [ { "kind": "tool_failure", "tool": "SearchMail", "errorKind": "input", "hoursAgo": 23 } ],
      "expect": [ { "tool": "SearchMail", "incidents": 2, "reasons": [ "tool_failed" ], "errorKinds": [ "input" ] } ] },
    { "id": "one-failure-is-noise",
      "traces": [ { "id": "t1", "conversation": "c1", "message": "m1", "hoursAgo": 24, "tools": [ { "tool": "SearchMail", "outcome": "failed" } ] } ],
      "expect": [] },
    { "id": "old-failures-do-not-count",
      "traces": [ { "id": "t1", "conversation": "c1", "message": "m1", "hoursAgo": 200, "tools": [ { "tool": "SearchMail", "outcome": "failed" } ] },
                  { "id": "t2", "conversation": "c2", "message": "m2", "hoursAgo": 220, "tools": [ { "tool": "SearchMail", "outcome": "failed" } ] } ],
      "expect": [] },
    { "id": "working-tools-stay-quiet",
