      "signals": [ { "kind": "thumbs_down", "message": "m1", "hoursAgo": 20 }, { "kind": "thumbs_down", "message": "m2", "hoursAgo": 20 } ],
      "expect": [ { "tool": "PlanDay", "incidents": 2, "reasons": [ "thumbs_down" ] } ] },
    { "id": "the-last-thumb-wins",
