# Optional overrides for local development; the AppHost has defaults for all of these. To use it:
#   cp .env.example infra/compose/.env && set -a && source infra/compose/.env && set +a
#   dotnet run --project src/Jarvis.AppHost
# Production needs no file: scripts/deploy/prepare-host.sh generates infra/compose/.env.production.

# Optional parts: browser github home-assistant verification (see README → Run locally).
JARVIS_FEATURES=
JARVIS_LISTEN_URL=http://localhost:5082
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-at-least-32-bytes-of-random-secret
VOICE_WORKER_SECRET=change-me-to-a-long-random-secret
MCP_RUNNER_TOKEN=change-me-to-at-least-32-random-characters
# Needed for the home-assistant feature.
HOME_ASSISTANT_MCP_URL=
# Optional. Aspire starts the bundled signal-cli REST API unless this points elsewhere.
SIGNAL_CLI_REST_URL=
# Optional. Aspire builds the Baileys WhatsApp bridge (scan a QR code in the app to link WhatsApp).
# Set the URL only when the bridge runs elsewhere.
WHATSAPP_BRIDGE_URL=
