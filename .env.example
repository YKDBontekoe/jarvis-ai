POSTGRES_PASSWORD=change-me-to-a-long-random-password
CODEX_AUTH_FILE=${HOME}/.codex/auth.json
S3_ACCESS_KEY=jarvis-local-access
S3_SECRET_KEY=replace-with-a-random-local-secret
JARVIS_BIND_ADDRESS=127.0.0.1
JARVIS_LISTEN_URL=http://localhost:5082
LIVEKIT_BIND_ADDRESS=127.0.0.1
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-at-least-32-bytes-of-random-secret
VOICE_WORKER_SECRET=change-me-to-a-long-random-secret
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=/dev/null
HOME_ASSISTANT_MCP_URL=
# Optional. Aspire and Compose default to the bundled signal-cli REST API.
SIGNAL_CLI_REST_URL=
