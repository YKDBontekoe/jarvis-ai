# Production settings. You do not need to edit this file: scripts/deploy/prepare-host.sh (run by every deploy)
# copies it to infra/compose/.env.production, keeps that file at mode 0600, and fills in every empty managed value
# below. Values you set yourself are never changed.

# --- The one required input: the public hostname. The deploy workflow passes the JARVIS_DOMAIN repository variable.
JARVIS_DOMAIN=

# --- Managed: generated or derived on first deploy. Leave empty unless you are migrating an existing server.
LIVEKIT_DOMAIN=
JARVIS_WEB_ORIGIN=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_SIGNING_KEY=
POSTGRES_PASSWORD=
TEMPORAL_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_WORKER_SECRET=
MCP_RUNNER_TOKEN=
JARVIS_UID=
JARVIS_GID=
# Under JARVIS_DATA_DIR (default $HOME/jarvis-data), created with mode 0700.
CODEX_HOME_DIR=
JARVIS_DATA_PROTECTION_KEYS_DIR=
JARVIS_BACKUP_DIR=
GARAGE_CONFIG_FILE=

# --- Set by the deploy workflow.
JARVIS_API_IMAGE=ghcr.io/ykdbontekoe/jarvis-ai/api:latest
JARVIS_WORKER_IMAGE=ghcr.io/ykdbontekoe/jarvis-ai/worker:latest
SENTRY_RELEASE=

# --- Optional.
AUTH_ALLOW_REGISTRATION=true
# Encrypt each backup file with this passphrase. Store it somewhere else too; without it a backup cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_HOUR_UTC=3
BACKUP_RETENTION_DAYS=14
# Push notifications: a Firebase project and its service account file.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=/dev/null
# Needed only with the home-assistant feature.
HOME_ASSISTANT_MCP_URL=
# Only when signal-cli or the WhatsApp bridge run outside this deployment.
SIGNAL_CLI_REST_URL=
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=
# Model overrides; empty uses the signed-in account's defaults.
CODEX_MODEL_FAST=
CODEX_MODEL_STANDARD=
CODEX_MODEL_REASONING=
CODEX_MODEL_CODING=
CODEX_MODEL_VISION=
CODEX_MODEL_REALTIME=
JARVIS_MODEL_CLASS=
# Local embedding model, downloaded on first start. Set EMBEDDINGS_BASE_URL= (empty) to switch it off.
# EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDINGS_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
# EMBEDDINGS_BASE_URL=http://embeddings:80/v1
MAX_UPLOAD_BYTES=20971520
LIVEKIT_BIND_ADDRESS=0.0.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sentry. Leave SENTRY_DSN unset to use the project configured in the AppHost.
# SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_PROFILES_SAMPLE_RATE=0
# SENTRY_RECORD_AI_CONTENT=false
