# Replace every placeholder before deployment. Keep the actual file mode 0600.
POSTGRES_PASSWORD=replace_with_a_random_64_character_hex_value
TEMPORAL_PASSWORD=replace_with_a_different_random_64_character_hex_value
S3_ACCESS_KEY=jarvis_object_store
S3_SECRET_KEY=replace_with_another_random_64_character_hex_value
GARAGE_CONFIG_FILE=/absolute/path/to/garage.toml

JARVIS_UID=1000
JARVIS_GID=1000
# GHCR images used by scripts/deploy/remote-up.sh. The deploy workflow
# overrides these with the git SHA that was just pushed.
JARVIS_API_IMAGE=ghcr.io/ykdbontekoe/jarvis-ai/api:latest
JARVIS_WORKER_IMAGE=ghcr.io/ykdbontekoe/jarvis-ai/worker:latest
JARVIS_VOICE_WORKER_IMAGE=ghcr.io/ykdbontekoe/jarvis-ai/voice-worker:latest
CODEX_HOME_DIR=/absolute/path/to/jarvis/codex-home
JARVIS_DATA_PROTECTION_KEYS_DIR=/absolute/path/to/jarvis/data-protection-keys
AUTH_ISSUER=https://jarvis.example.com
AUTH_AUDIENCE=jarvis-api
AUTH_SIGNING_KEY=replace_with_a_random_64_character_hex_value
AUTH_ALLOW_REGISTRATION=true
JARVIS_DOMAIN=jarvis.example.com
LIVEKIT_DOMAIN=voice.example.com
JARVIS_WEB_ORIGIN=https://jarvis.example.com
SIGNAL_CLI_REST_URL=

LIVEKIT_API_KEY=replace_with_a_random_key
LIVEKIT_API_SECRET=replace_with_a_random_secret
VOICE_WORKER_SECRET=replace_with_a_random_secret
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=/dev/null
HOME_ASSISTANT_MCP_URL=

CODEX_MODEL_FAST=
CODEX_MODEL_STANDARD=
CODEX_MODEL_REASONING=
CODEX_MODEL_CODING=
CODEX_MODEL_VISION=
CODEX_MODEL_REALTIME=
JARVIS_MODEL_CLASS=
MAX_UPLOAD_BYTES=20971520
LIVEKIT_BIND_ADDRESS=0.0.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
